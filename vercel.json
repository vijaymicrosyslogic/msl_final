{
  "redirects": [
    {
      "source": "/cpanel",
      "destination": "https://cpanel.microsyslogic.com",
      "permanent": true
    },
    {
      "source": "/webmail",
      "destination": "https://webmail.microsyslogic.com",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
